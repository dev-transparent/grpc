# Shared helpers for the protobuf specs.
module ProtobufSpec
  ROOT      = File.expand_path("../..", __DIR__)
  PROTO_DIR = File.join(__DIR__, "proto")
  TMP_DIR   = File.join(ROOT, "tmp", "protobuf_spec")

  # Spec protos generated into spec/protobuf/generated by
  # script/generate_spec_protos.sh.
  SPEC_PROTOS = %w(
    google/protobuf/test_messages_proto3.proto
    google/protobuf/test_messages_proto2.proto
    spec_test/types.proto
    spec_test/sub/imported.proto
    spec_test/editions.proto
    spec_test/editions_implicit.proto
    spec_test/proto2.proto
    spec_test/service.proto
    conformance/conformance.proto
    conformance/test_protos/test_messages_edition2023.proto
    conformance/test_protos/test_messages_edition_unstable.proto
    editions/golden/test_messages_proto2_editions.proto
    editions/golden/test_messages_proto3_editions.proto
  )

  # Files generated into src/protobuf by script/generate_well_known_types.sh.
  WELL_KNOWN_PROTOS = %w(
    google/protobuf/descriptor.proto
    google/protobuf/compiler/plugin.proto
    google/protobuf/any.proto
    google/protobuf/api.proto
    google/protobuf/duration.proto
    google/protobuf/empty.proto
    google/protobuf/field_mask.proto
    google/protobuf/source_context.proto
    google/protobuf/struct.proto
    google/protobuf/timestamp.proto
    google/protobuf/type.proto
    google/protobuf/wrappers.proto
  )

  PYTHON = ENV["PYTHON"]? || "/tmp/grpc-venv-dir/venv/bin/python"

  def self.protoc : String?
    Process.find_executable("protoc")
  end

  # The include directory holding the well-known type protos shipped with
  # protoc.
  def self.protoc_include : String?
    if dir = ENV["PROTOC_INCLUDE"]?
      return dir
    end
    protoc.try do |path|
      dir = File.join(File.dirname(File.dirname(File.realpath(path))), "include")
      dir = File.join(File.dirname(File.dirname(path)), "include") unless File.exists?(File.join(dir, "google/protobuf/any.proto"))
      dir if File.exists?(File.join(dir, "google/protobuf/any.proto"))
    end
  end

  def self.include_args : Array(String)
    args = ["-I#{PROTO_DIR}"]
    protoc_include.try { |dir| args << "-I#{dir}" }
    args
  end

  def self.tmp_path(name : String) : String
    Dir.mkdir_p(TMP_DIR)
    File.join(TMP_DIR, "#{Process.pid}-#{Random.new.hex(6)}-#{name}")
  end

  # Runs protoc with *args*, feeding *input* on stdin. Returns the exit
  # status, stdout and stderr.
  def self.run_protoc(args : Array(String), input : Bytes | String = "") : {Process::Status, Bytes, String}
    stdout = IO::Memory.new
    stderr = IO::Memory.new
    status = Process.run(protoc.not_nil!, args, input: IO::Memory.new(input.to_slice), output: stdout, error: stderr)
    {status, stdout.to_slice, stderr.to_s}
  end

  # Encodes the text-format *text* as message *type* using `protoc --encode`.
  def self.protoc_encode(type : String, proto : String, text : String) : Bytes
    status, output, error = run_protoc(["--encode=#{type}"] + include_args + [proto], text)
    raise "protoc --encode failed: #{error}" unless status.success?
    output
  end

  # Decodes *bytes* as message *type* using `protoc --decode`, returning
  # the text format.
  def self.protoc_decode(type : String, proto : String, bytes : Bytes) : String
    status, output, error = run_protoc(["--decode=#{type}"] + include_args + [proto], bytes)
    raise "protoc --decode failed: #{error}" unless status.success?
    String.new(output)
  end

  # Parses *protos* with protoc and returns the resulting descriptors
  # (including imports and source info).
  def self.descriptor_set(protos : Array(String), include_dirs : Array(String) = include_args) : Google::Protobuf::FileDescriptorSet
    path = tmp_path("descriptors.pb")
    begin
      status, _, error = run_protoc(["--descriptor_set_out=#{path}", "--include_source_info", "--include_imports"] + include_dirs + protos)
      raise "protoc failed: #{error}" unless status.success?
      Google::Protobuf::FileDescriptorSet.from_protobuf(File.read(path).to_slice)
    ensure
      File.delete?(path)
    end
  end

  # Runs the generator in-process on *protos*.
  def self.generate(protos : Array(String), parameter : String? = nil, include_dirs : Array(String) = include_args) : Google::Protobuf::Compiler::CodeGeneratorResponse
    set = descriptor_set(protos, include_dirs)
    request = Google::Protobuf::Compiler::CodeGeneratorRequest.new(
      file_to_generate: protos, parameter: parameter, proto_file: set.file)
    Protobuf::Compiler::Generator.call(request)
  end

  # Returns the generated files of *response* by name.
  def self.files(response : Google::Protobuf::Compiler::CodeGeneratorResponse) : Hash(String, String)
    response.file.to_h { |file| {file.name.not_nil!, file.content.not_nil!} }
  end

  def self.hex(bytes : Bytes) : String
    bytes.hexstring
  end

  # Builds bytes from a hex string, ignoring whitespace.
  def self.unhex(string : String) : Bytes
    string.gsub(/\s+/, "").hexbytes
  end
end

# Shorthand for building byte slices in specs.
def bytes(*values : Int) : Bytes
  Bytes.new(values.size) { |i| values[i].to_u8 }
end

def hexbytes(string : String) : Bytes
  ProtobufSpec.unhex(string)
end

def encode_with(& : Protobuf::Writer ->) : Bytes
  io = IO::Memory.new
  yield Protobuf::Writer.new(io)
  io.to_slice
end

macro skip_without_protoc
  unless ProtobufSpec.protoc && ProtobufSpec.protoc_include
    pending!("protoc (with its include directory) is not on PATH")
  end
end

module ProtobufSpec
  # Describes how two messages differ (through their JSON forms), or
  # returns `nil` if they are equal.
  def self.difference(a : Protobuf::Message, b : Protobuf::Message) : String?
    return nil if a == b
    json_a = a.to_json(emit_defaults: true)
    json_b = b.to_json(emit_defaults: true)
    if json_a == json_b
      return "messages differ outside JSON (unknown fields #{a.unknown_fields.hexstring} vs #{b.unknown_fields.hexstring}, or NaN values)"
    end
    json_difference(JSON.parse(json_a), JSON.parse(json_b), "") ||
      "messages differ outside their JSON form:\n  #{a.inspect.gsub(/:0x[0-9a-f]+/, "")[0, 100000]}\n  #{b.inspect.gsub(/:0x[0-9a-f]+/, "")[0, 100000]}"
  end
end

module ProtobufSpec
  # The path of the first difference between two JSON values.
  def self.json_difference(a : JSON::Any, b : JSON::Any, path : String) : String?
    if (ha = a.as_h?) && (hb = b.as_h?)
      (ha.keys | hb.keys).each do |key|
        va, vb = ha[key]?, hb[key]?
        return "#{path}/#{key}: #{va.to_json} != #{vb.to_json}" if va.nil? || vb.nil?
        if difference = json_difference(va, vb, "#{path}/#{key}")
          return difference
        end
      end
      nil
    elsif (aa = a.as_a?) && (ab = b.as_a?)
      return "#{path}: #{a.to_json} != #{b.to_json}" unless aa.size == ab.size
      aa.each_with_index do |va, i|
        if difference = json_difference(va, ab[i], "#{path}[#{i}]")
          return difference
        end
      end
      nil
    else
      a == b ? nil : "#{path}: #{a.to_json} != #{b.to_json}"
    end
  end
end

# Fails with a readable difference unless *actual* equals *expected*.
def message_should_eq(actual : Protobuf::Message, expected : Protobuf::Message, file = __FILE__, line = __LINE__)
  if difference = ProtobufSpec.difference(actual, expected)
    fail(difference, file, line)
  end
end
