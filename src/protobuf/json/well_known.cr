# Special JSON representations of the well-known types
# (https://protobuf.dev/programming-guides/json/#wkt).
#
# Each class defines `protobuf_json_write` / `protobuf_json_merge`, which
# replace the generic field-by-field mapping generated by
# `Protobuf::Message`.

module Protobuf::JSON
  # Well-known types that are represented in `Any` with a `value` member
  # instead of inline fields.
  # :nodoc:
  SPECIAL_ANY_TYPES = Set{
    "google.protobuf.Any", "google.protobuf.Duration", "google.protobuf.Timestamp",
    "google.protobuf.FieldMask", "google.protobuf.Struct", "google.protobuf.Value",
    "google.protobuf.ListValue",
    "google.protobuf.DoubleValue", "google.protobuf.FloatValue", "google.protobuf.Int64Value",
    "google.protobuf.UInt64Value", "google.protobuf.Int32Value", "google.protobuf.UInt32Value",
    "google.protobuf.BoolValue", "google.protobuf.StringValue", "google.protobuf.BytesValue",
  }

  # Seconds of 0001-01-01T00:00:00Z and 9999-12-31T23:59:59Z.
  # :nodoc:
  TIMESTAMP_MIN_SECONDS = -62_135_596_800_i64
  # :nodoc:
  TIMESTAMP_MAX_SECONDS = 253_402_300_799_i64
  # :nodoc:
  DURATION_MAX_SECONDS = 315_576_000_000_i64

  # :nodoc:
  def self.format_nanos(io : IO, nanos : Int32) : Nil
    return if nanos == 0
    io << '.'
    if nanos % 1_000_000 == 0
      io << (nanos // 1_000_000).to_s.rjust(3, '0')
    elsif nanos % 1_000 == 0
      io << (nanos // 1_000).to_s.rjust(6, '0')
    else
      io << nanos.to_s.rjust(9, '0')
    end
  end

  # :nodoc:
  def self.parse_nanos(fraction : String?) : Int32
    return 0 unless fraction
    fraction.ljust(9, '0').to_i
  end

  # Formats a timestamp as RFC 3339 in UTC ("1972-01-01T10:00:20.021Z").
  def self.format_timestamp(seconds : Int64, nanos : Int32) : String
    unless TIMESTAMP_MIN_SECONDS <= seconds <= TIMESTAMP_MAX_SECONDS && 0 <= nanos <= 999_999_999
      raise SerializeError.new("Timestamp out of range: seconds=#{seconds} nanos=#{nanos}")
    end
    time = Time.unix(seconds)
    String.build do |io|
      io << time.year.to_s.rjust(4, '0')
      time.to_s(io, "-%m-%dT%H:%M:%S")
      format_nanos(io, nanos)
      io << 'Z'
    end
  end

  TIMESTAMP = /\A([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})(?:\.([0-9]{1,9}))?(?:(Z)|([+-])([0-9]{2}):([0-9]{2}))\z/

  # Parses an RFC 3339 timestamp, returning seconds and nanos, or `nil`.
  def self.parse_timestamp(text : String) : {Int64, Int32}?
    match = TIMESTAMP.match(text) || return nil
    year, month, day = match[1].to_i, match[2].to_i, match[3].to_i
    hour, minute, second = match[4].to_i, match[5].to_i, match[6].to_i
    return nil unless 1 <= month <= 12 && 1 <= day <= Time.days_in_month(year.clamp(1, 9999), month)
    return nil unless hour < 24 && minute < 60 && second < 60 && year >= 1
    seconds = Time.utc(year, month, day, hour, minute, second).to_unix
    unless match[8]?
      offset = match[10].to_i * 3600 + match[11].to_i * 60
      return nil unless match[10].to_i < 24 && match[11].to_i < 60
      seconds -= match[9] == "+" ? offset : -offset
    end
    return nil unless TIMESTAMP_MIN_SECONDS <= seconds <= TIMESTAMP_MAX_SECONDS
    {seconds, parse_nanos(match[7]?)}
  rescue ArgumentError
    nil
  end

  # Formats a duration ("1.5s", "-0.000001s").
  def self.format_duration(seconds : Int64, nanos : Int32) : String
    unless -DURATION_MAX_SECONDS <= seconds <= DURATION_MAX_SECONDS && -999_999_999 <= nanos <= 999_999_999 &&
           !(seconds > 0 && nanos < 0) && !(seconds < 0 && nanos > 0)
      raise SerializeError.new("Duration out of range: seconds=#{seconds} nanos=#{nanos}")
    end
    String.build do |io|
      io << '-' if seconds < 0 || nanos < 0
      io << seconds.abs
      format_nanos(io, nanos.abs)
      io << 's'
    end
  end

  DURATION = /\A(-)?([0-9]+)(?:\.([0-9]{1,9}))?s\z/

  # Parses a duration, returning seconds and nanos, or `nil`.
  def self.parse_duration(text : String) : {Int64, Int32}?
    match = DURATION.match(text) || return nil
    return nil if match[2].size > 12
    seconds = match[2].to_i64
    nanos = parse_nanos(match[3]?)
    return nil if seconds > DURATION_MAX_SECONDS
    if match[1]?
      seconds = -seconds
      nanos = -nanos
    end
    {seconds, nanos}
  end

  # Converts a field mask path to its JSON form (lowerCamelCase), or
  # `nil` if it would not round trip.
  def self.field_mask_path_to_json(path : String) : String?
    String.build do |io|
      upcase_next = false
      path.each_char do |char|
        return nil if char.ascii_uppercase?
        if char == '_'
          return nil if upcase_next
          upcase_next = true
        elsif upcase_next
          return nil unless char.ascii_lowercase?
          io << char.upcase
          upcase_next = false
        else
          io << char
        end
      end
      return nil if upcase_next
    end
  end

  # Converts a JSON field mask path (lowerCamelCase) to a proto path.
  def self.field_mask_path_from_json(path : String) : String?
    String.build do |io|
      path.each_char do |char|
        return nil if char == '_'
        if char.ascii_uppercase?
          io << '_' << char.downcase
        else
          io << char
        end
      end
    end
  end

  # :nodoc:
  def self.expect_string(pull : ::JSON::PullParser, what : String) : String
    error(pull, "Expected a string for #{what}, found #{describe(pull)}") unless pull.kind.string?
    pull.read_string
  end
end

module Google::Protobuf
  class Any
    # :nodoc:
    def protobuf_json_write(json : ::JSON::Builder, options : ::Protobuf::JSON::PrintOptions) : Nil
      if type_url.empty?
        raise ::Protobuf::JSON::SerializeError.new("Any with an empty type URL but a value") unless value.empty?
        json.object { }
        return
      end
      klass = ::Protobuf::Registry.message_class_for_type_url(type_url) ||
              raise ::Protobuf::JSON::SerializeError.new("Cannot print Any: unknown type #{type_url}")
      # Each Any is decoded separately, so nesting is not bounded by the
      # decoder's recursion limit.
      if options.any_depth >= ::Protobuf::DEFAULT_RECURSION_LIMIT
        raise ::Protobuf::JSON::SerializeError.new("Any values are nested too deeply")
      end
      options = options.copy_with(any_depth: options.any_depth + 1)
      begin
        message = klass.from_protobuf(value)
      rescue ex : ::Protobuf::DecodeError
        raise ::Protobuf::JSON::SerializeError.new("Cannot print Any: invalid #{klass.full_name} payload: #{ex.message}")
      end
      json.object do
        json.field("@type", type_url)
        if ::Protobuf::JSON::SPECIAL_ANY_TYPES.includes?(klass.full_name)
          json.field("value") { message.protobuf_json_write(json, options) }
        else
          message.protobuf_json_write_fields(json, options)
        end
      end
    end

    # :nodoc:
    def protobuf_json_merge(pull : ::JSON::PullParser, context : ::Protobuf::JSON::Context) : Nil
      unless pull.kind.begin_object?
        ::Protobuf::JSON.error(pull, "Expected an object for google.protobuf.Any, found #{::Protobuf::JSON.describe(pull)}")
      end
      members = [] of {String, String}
      type = nil
      pull.read_object do |key|
        if key == "@type"
          ::Protobuf::JSON.error(pull, "Duplicate @type in Any") if type
          type = ::Protobuf::JSON.expect_string(pull, "@type")
        else
          ::Protobuf::JSON.error(pull, "Duplicate field #{key.inspect}") if members.any? { |(name, _)| name == key }
          members << {key, pull.read_raw}
        end
      end
      unless type
        ::Protobuf::JSON.error(pull, "Any is missing @type") unless members.empty?
        return
      end
      klass = ::Protobuf::Registry.message_class_for_type_url(type)
      unless klass
        ::Protobuf::JSON.error(pull, "Invalid or unknown Any type URL #{type.inspect}")
      end
      unless type.includes?('/')
        ::Protobuf::JSON.error(pull, "Invalid Any type URL #{type.inspect}")
      end
      message = if ::Protobuf::JSON::SPECIAL_ANY_TYPES.includes?(klass.full_name)
                  value = nil
                  members.each do |(name, raw)|
                    if name == "value"
                      value = raw
                    elsif !context.ignore_unknown_fields?
                      ::Protobuf::JSON.error(pull, "Unknown field #{name.inspect} in Any of type #{klass.full_name}")
                    end
                  end
                  if value
                    inner = ::JSON::PullParser.new(value)
                    klass.__protobuf_json_read(inner, context)
                  else
                    klass.new_message
                  end
                else
                  object = String.build do |io|
                    io << '{'
                    members.each_with_index do |(name, raw), i|
                      io << ',' if i > 0
                      name.to_json(io)
                      io << ':' << raw
                    end
                    io << '}'
                  end
                  klass.__protobuf_json_read(::JSON::PullParser.new(object), context)
                end
      self.type_url = type
      self.value = message.to_protobuf
    end

    # Packs *message* into an `Any` (type URL
    # `type.googleapis.com/<full name>`).
    def self.pack(message : ::Protobuf::Message, type_url_prefix : String = "type.googleapis.com/") : self
      prefix = type_url_prefix.ends_with?('/') ? type_url_prefix : "#{type_url_prefix}/"
      new(type_url: "#{prefix}#{message.class.full_name}", value: message.to_protobuf)
    end

    # The full name of the packed message type (the part of the type URL
    # after the last '/').
    def type_name : String
      url = type_url
      slash = url.rindex('/')
      slash ? url[(slash + 1)..] : url
    end

    # Returns `true` if the packed message is a *type*.
    def is?(type : ::Protobuf::MessageClass) : Bool
      type_name == type.full_name
    end

    # Unpacks the message as *type*, raising `Protobuf::Error` if the
    # type URL does not match.
    def unpack(type : T.class) : T forall T
      unless type_name == T.full_name
        raise ::Protobuf::Error.new("Any contains #{type_name}, not #{T.full_name}")
      end
      T.from_protobuf(value)
    end

    # Unpacks the message using the class registered for its type.
    def unpack : ::Protobuf::Message
      klass = ::Protobuf::Registry.message_class_for_type_url(type_url) ||
              raise ::Protobuf::Error.new("Unknown Any type #{type_url}")
      klass.from_protobuf(value)
    end
  end

  class Timestamp
    # :nodoc:
    def protobuf_json_write(json : ::JSON::Builder, options : ::Protobuf::JSON::PrintOptions) : Nil
      json.string(::Protobuf::JSON.format_timestamp(seconds, nanos))
    end

    # :nodoc:
    def protobuf_json_merge(pull : ::JSON::PullParser, context : ::Protobuf::JSON::Context) : Nil
      text = ::Protobuf::JSON.expect_string(pull, "google.protobuf.Timestamp")
      self.seconds, self.nanos = ::Protobuf::JSON.parse_timestamp(text) ||
                                 ::Protobuf::JSON.error(pull, "Invalid timestamp #{text.inspect}")
    end

    # Returns the timestamp for *time*.
    def self.from_time(time : ::Time) : self
      new(seconds: time.to_unix, nanos: time.nanosecond)
    end

    # Returns the current time.
    def self.now : self
      from_time(::Time.utc)
    end

    # Converts the timestamp to a `Time` (UTC).
    def to_time : ::Time
      ::Time.unix(seconds) + nanos.nanoseconds
    end
  end

  class Duration
    # :nodoc:
    def protobuf_json_write(json : ::JSON::Builder, options : ::Protobuf::JSON::PrintOptions) : Nil
      json.string(::Protobuf::JSON.format_duration(seconds, nanos))
    end

    # :nodoc:
    def protobuf_json_merge(pull : ::JSON::PullParser, context : ::Protobuf::JSON::Context) : Nil
      text = ::Protobuf::JSON.expect_string(pull, "google.protobuf.Duration")
      self.seconds, self.nanos = ::Protobuf::JSON.parse_duration(text) ||
                                 ::Protobuf::JSON.error(pull, "Invalid duration #{text.inspect}")
    end

    # Returns the duration for *span*.
    def self.from_span(span : ::Time::Span) : self
      new(seconds: span.total_seconds.to_i64, nanos: (span - span.total_seconds.to_i64.seconds).total_nanoseconds.to_i32)
    end

    # Converts the duration to a `Time::Span`.
    def to_span : ::Time::Span
      ::Time::Span.new(seconds: seconds, nanoseconds: nanos)
    end
  end

  class FieldMask
    # :nodoc:
    def protobuf_json_write(json : ::JSON::Builder, options : ::Protobuf::JSON::PrintOptions) : Nil
      converted = paths.map do |path|
        ::Protobuf::JSON.field_mask_path_to_json(path) ||
          raise ::Protobuf::JSON::SerializeError.new("FieldMask path #{path.inspect} cannot be represented in JSON")
      end
      json.string(converted.join(','))
    end

    # :nodoc:
    def protobuf_json_merge(pull : ::JSON::PullParser, context : ::Protobuf::JSON::Context) : Nil
      text = ::Protobuf::JSON.expect_string(pull, "google.protobuf.FieldMask")
      return if text.empty?
      self.paths = text.split(',').map do |path|
        ::Protobuf::JSON.field_mask_path_from_json(path) ||
          ::Protobuf::JSON.error(pull, "Invalid FieldMask path #{path.inspect}")
      end
    end
  end

  class Struct
    # :nodoc:
    def protobuf_json_write(json : ::JSON::Builder, options : ::Protobuf::JSON::PrintOptions) : Nil
      json.object do
        fields.each do |key, value|
          json.field(::Protobuf::JSON.check_utf8(key)) { value.protobuf_json_write(json, options) }
        end
      end
    end

    # :nodoc:
    def protobuf_json_merge(pull : ::JSON::PullParser, context : ::Protobuf::JSON::Context) : Nil
      unless pull.kind.begin_object?
        ::Protobuf::JSON.error(pull, "Expected an object for google.protobuf.Struct, found #{::Protobuf::JSON.describe(pull)}")
      end
      pull.read_object do |key|
        ::Protobuf::JSON.error(pull, "Duplicate key #{key.inspect}") if fields.has_key?(key)
        fields[key] = ::Protobuf::JSON.read_message(pull, Value, context)
      end
    end
  end

  class ListValue
    # :nodoc:
    def protobuf_json_write(json : ::JSON::Builder, options : ::Protobuf::JSON::PrintOptions) : Nil
      json.array do
        values.each { |value| value.protobuf_json_write(json, options) }
      end
    end

    # :nodoc:
    def protobuf_json_merge(pull : ::JSON::PullParser, context : ::Protobuf::JSON::Context) : Nil
      unless pull.kind.begin_array?
        ::Protobuf::JSON.error(pull, "Expected an array for google.protobuf.ListValue, found #{::Protobuf::JSON.describe(pull)}")
      end
      pull.read_array do
        values << ::Protobuf::JSON.read_message(pull, Value, context)
      end
    end
  end

  class Value
    # :nodoc:
    def protobuf_json_write(json : ::JSON::Builder, options : ::Protobuf::JSON::PrintOptions) : Nil
      case value = kind
      when NullValue
        json.null
      when Float64
        if value.nan? || value.infinite?
          raise ::Protobuf::JSON::SerializeError.new("google.protobuf.Value cannot hold #{value}")
        end
        json.raw(::Protobuf::JSON.format_float(value))
      when String
        json.string(::Protobuf::JSON.check_utf8(value))
      when Bool
        json.bool(value)
      when Struct, ListValue
        value.protobuf_json_write(json, options)
      else
        raise ::Protobuf::JSON::SerializeError.new("google.protobuf.Value has no kind set")
      end
    end

    # :nodoc:
    def protobuf_json_merge(pull : ::JSON::PullParser, context : ::Protobuf::JSON::Context) : Nil
      case pull.kind
      when .null?
        pull.read_null
        self.null_value = NullValue::NULL_VALUE
      when .bool?
        self.bool_value = pull.read_bool
      when .int?, .float?
        self.number_value = ::Protobuf::JSON.read_float(pull, Float64)
      when .string?
        self.string_value = pull.read_string
      when .begin_object?
        self.struct_value = ::Protobuf::JSON.read_message(pull, Struct, context)
      when .begin_array?
        self.list_value = ::Protobuf::JSON.read_message(pull, ListValue, context)
      else
        ::Protobuf::JSON.error(pull, "Expected a JSON value, found #{::Protobuf::JSON.describe(pull)}")
      end
    end
  end

  {% for name, type in {DoubleValue: Float64, FloatValue: Float32, Int64Value: Int64, UInt64Value: UInt64,
                        Int32Value: Int32, UInt32Value: UInt32, BoolValue: Bool, StringValue: String, BytesValue: Bytes} %}
    class {{name.id}}
      # :nodoc:
      def protobuf_json_write(json : ::JSON::Builder, options : ::Protobuf::JSON::PrintOptions) : Nil
        ::Protobuf::JSON.write_value(json, value, options)
      end

      # :nodoc:
      def protobuf_json_merge(pull : ::JSON::PullParser, context : ::Protobuf::JSON::Context) : Nil
        self.value = ::Protobuf::JSON.read_value(pull, {{type}}, context).not_nil!
      end
    end
  {% end %}
end
