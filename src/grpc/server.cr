module GRPC
  # Implemented by service base classes generated by protoc-gen-crystal.
  module Service
    # The fully qualified service name, e.g. `helloworld.Greeter`.
    abstract def service_name : String
    # The service's methods and their handlers.
    abstract def rpc_methods : Array(RpcMethod)
  end

  # A method of a service together with its server-side handler.
  class RpcMethod
    enum Kind
      Unary
      ServerStreaming
      ClientStreaming
      BidiStreaming
    end

    getter name : String
    getter kind : Kind
    getter handler : Proc(ServerCall, Nil)

    def initialize(@name : String, @kind : Kind, @handler : Proc(ServerCall, Nil))
    end

    def self.unary(name : String, request_type : Req.class, response_type : Resp.class, &block : Req, ServerContext -> Resp) : RpcMethod forall Req, Resp
      new(name, Kind::Unary, ->(call : ServerCall) {
        request = call.read_single_message(Req)
        call.send_message(block.call(request, call.context))
        nil
      })
    end

    def self.server_streaming(name : String, request_type : Req.class, response_type : Resp.class, &block : Req, ResponseStream(Resp), ServerContext -> _) : RpcMethod forall Req, Resp
      new(name, Kind::ServerStreaming, ->(call : ServerCall) {
        request = call.read_single_message(Req)
        block.call(request, ResponseStream(Resp).new(call), call.context)
        nil
      })
    end

    def self.client_streaming(name : String, request_type : Req.class, response_type : Resp.class, &block : RequestStream(Req), ServerContext -> Resp) : RpcMethod forall Req, Resp
      new(name, Kind::ClientStreaming, ->(call : ServerCall) {
        call.send_message(block.call(RequestStream(Req).new(call), call.context))
        nil
      })
    end

    def self.bidi_streaming(name : String, request_type : Req.class, response_type : Resp.class, &block : RequestStream(Req), ResponseStream(Resp), ServerContext -> _) : RpcMethod forall Req, Resp
      new(name, Kind::BidiStreaming, ->(call : ServerCall) {
        block.call(RequestStream(Req).new(call), ResponseStream(Resp).new(call), call.context)
        nil
      })
    end
  end

  # The stream of request messages of a client or bidirectional streaming
  # call. Iterate it to receive messages until the client closes its side.
  #
  # ```
  # def record_route(requests, context)
  #   requests.each { |point| ... }
  # end
  # ```
  class RequestStream(T)
    include Iterator(T)

    def initialize(@call : ServerCall)
    end

    # Receives the next message, or `nil` once the client finished sending.
    def receive? : T?
      @call.read_message(T)
    end

    def next
      receive? || stop
    end
  end

  # The stream of response messages of a server or bidirectional streaming
  # call.
  class ResponseStream(T)
    def initialize(@call : ServerCall)
    end

    # Sends a response message. Raises `GRPC::Error` if the call was
    # cancelled.
    def send(message : T) : Nil
      @call.send_message(message)
    end

    def <<(message : T) : self
      send(message)
      self
    end
  end

  # The server side of a single call. Implements the gRPC protocol
  # (message framing, compression, headers and trailers, and the gRPC-Web
  # variants) on top of a `ServerTransport`.
  class ServerCall
    # The wire protocol of a call.
    enum Protocol
      # Standard gRPC over HTTP/2 (`application/grpc`).
      GRPC
      # gRPC-Web (`application/grpc-web`): trailers are sent in the body.
      Web
      # gRPC-Web-text (`application/grpc-web-text`): base64 encoded gRPC-Web.
      WebText

      # Whether this is one of the gRPC-Web variants.
      def grpc_web? : Bool
        !grpc?
      end
    end

    getter context : ServerContext
    getter transport : ServerTransport
    getter protocol : Protocol
    getter rpc_info : Stats::RPCInfo

    # Called once with the final status (used for server call counters).
    property on_finish : Proc(Status, Nil)? = nil

    @mutex = Mutex.new
    @headers_sent = false
    @finished = false
    @messages_sent = 0
    @messages_received = 0
    @request_body : IO

    def initialize(@transport : ServerTransport, @context : ServerContext, @request_encoding : String?,
                   @accepted_encodings : Array(String), @max_receive_message_size : Int32,
                   @max_send_message_size : Int32, @protocol : Protocol = Protocol::GRPC,
                   @response_content_type : String = "application/grpc",
                   @stats : Stats::Dispatcher = Stats::Dispatcher.new([] of StatsHandler))
      @rpc_info = Stats::RPCInfo.new(@context.method_path, client: false, peer: @context.peer)
      @request_body = @protocol.web_text? ? Base64StreamDecoder.new(@transport.request_body) : @transport.request_body
      @context.call = self
    end

    def self.new(stream : HTTP2::Stream, context : ServerContext, request_encoding : String?,
                 accepted_encodings : Array(String), max_receive_message_size : Int32,
                 max_send_message_size : Int32) : ServerCall
      new(HTTP2ServerTransport.new(stream), context, request_encoding, accepted_encodings,
        max_receive_message_size, max_send_message_size)
    end

    # The HTTP/2 stream of the call, if it is served over HTTP/2.
    def stream : HTTP2::Stream?
      @transport.as?(HTTP2ServerTransport).try(&.stream)
    end

    # Reads the next request message, returning `nil` at end of stream.
    def read_message(type : T.class) : T? forall T
      bytes = read_raw_message
      return nil unless bytes
      message = begin
        T.from_protobuf(bytes)
      rescue e : Protobuf::DecodeError
        raise Error.new(StatusCode::Internal, "Failed to parse request message: #{e.message}")
      end
      emit_in_payload(message, bytes.size)
      message
    end

    # Reads the next serialized request message (for generic handlers such
    # as proxies), returning `nil` at end of stream.
    def read_raw_message : Bytes?
      @context.check_cancelled!
      frame = begin
        Framing.read_frame(@request_body, @request_encoding, @max_receive_message_size)
      rescue e : TransportError
        transport_failed(e)
      end
      return nil unless frame
      bytes, compressed = frame
      @context.request_compressed = compressed
      @messages_received += 1
      connection_metrics.try &.record_message_received
      @last_in_compressed = compressed
      emit_in_payload(nil, bytes.size) if @raw_mode
      bytes
    end

    @last_in_compressed = false
    @raw_mode = false

    # Reads exactly one request message (for unary and server streaming
    # calls).
    def read_single_message(type : T.class) : T forall T
      message = read_message(T) || raise Error.new(StatusCode::Internal, "Expected a request message, received none")
      if read_raw_message
        raise Error.new(StatusCode::Internal, "Expected a single request message, received several")
      end
      message
    end

    def send_headers : Nil
      @mutex.synchronize { send_headers_locked }
    rescue e : TransportError
      transport_failed(e)
    end

    def send_message(message : Protobuf::Message) : Nil
      send_serialized(message.to_protobuf, message)
    end

    # Sends a serialized response message (for generic handlers).
    def send_raw_message(bytes : Bytes) : Nil
      send_serialized(bytes, nil)
    end

    private def send_serialized(bytes : Bytes, message : Protobuf::Message?) : Nil
      if bytes.size > @max_send_message_size
        raise Error.new(StatusCode::ResourceExhausted, "Response message larger than max (#{bytes.size} vs. #{@max_send_message_size})")
      end
      @mutex.synchronize do
        @context.check_cancelled!
        raise Error.new(StatusCode::Internal, "Call already finished") if @finished
        send_headers_locked
        encoding = response_encoding
        frame = Framing.encode(bytes, encoding)
        @transport.send_data(encode_body(frame))
        @messages_sent += 1
        connection_metrics.try &.record_message_sent
        emit(Stats::OutPayload.new(message, bytes.size, frame.size, !encoding.nil?))
      end
    rescue e : TransportError
      transport_failed(e)
    end

    # Completes the call with *status*, sending trailers. Uses a
    # trailers-only response if nothing was sent yet.
    def finish(status : Status) : Nil
      @mutex.synchronize do
        return if @finished
        @finished = true
        trailers = [{"grpc-status", status.code.value.to_s}]
        trailers << {"grpc-message", Status.encode_message(status.message)} unless status.message.empty?
        if details = status.details
          trailers << {"grpc-status-details-bin", Base64.strict_encode(details).rstrip('=')}
        end
        @context.trailers.to_fields(trailers)

        begin
          if !@headers_sent
            # Trailers-only response.
            @headers_sent = true
            fields = response_header_fields(include_encoding: false)
            fields.concat(trailers)
            emit(Stats::OutHeader.new(@context.response_metadata))
            @transport.send_headers(fields, end_stream: true)
          elsif @protocol.grpc_web?
            @transport.send_data(encode_body(web_trailer_frame(trailers)), end_stream: true)
          else
            @transport.send_trailers(trailers)
          end
        rescue TransportError
          # The client went away; there is nobody left to tell.
        end
        emit(Stats::Trailer.new(@context.trailers))
        emit(Stats::End.new(status, Time.utc - @rpc_info.started_at, @messages_sent, @messages_received))
      end
      @on_finish.try &.call(status)
    end

    private def connection_metrics : HTTP2::ConnectionMetrics?
      @transport.as?(HTTP2ServerTransport).try(&.stream.connection.metrics)
    end

    # Not synchronized: a send blocked on flow control holds the lock, and
    # the deadline timer must still be able to check the call.
    def finished? : Bool
      @finished
    end

    # Completes the call with DEADLINE_EXCEEDED once its deadline passed,
    # without waiting for the handler, then stops the client from sending.
    # A response being sent may hold the call lock while blocked on flow
    # control; the exchange is then aborted instead.
    def expire : Nil
      sent = ::Channel(Nil).new(1)
      spawn(name: "grpc-expire") do
        finish(Status.new(StatusCode::DeadlineExceeded, "Deadline exceeded"))
        sent.send(nil)
      end
      select
      when sent.receive
        @transport.stop_receiving
      when timeout(1.second)
        @transport.abort
      end
    end

    # :nodoc:
    def emit_begin(timeout : Time::Span?) : Nil
      emit(Stats::Begin.new(@rpc_info.started_at))
      emit(Stats::InHeader.new(@context.metadata, @request_encoding, timeout))
    end

    # :nodoc:
    def raw_mode! : Nil
      @raw_mode = true
    end

    # The transport failed: the client reset the call or the connection was
    # lost. Marks the call cancelled (running `on_cancel` callbacks even if
    # the handler notices before the transport's callback runs) and raises.
    private def transport_failed(error : TransportError) : NoReturn
      @context.check_cancelled!
      @context.cancel(StatusCode::Cancelled)
      raise Error.new(StatusCode::Cancelled, "Call cancelled: #{error.message}")
    end

    private def response_encoding : String?
      encoding = @context.compression
      return nil if encoding.nil? || encoding == Compression::IDENTITY
      @accepted_encodings.includes?(encoding) ? encoding : nil
    end

    private def response_header_fields(include_encoding : Bool) : Array({String, String})
      fields = [{":status", "200"}, {"content-type", @response_content_type}]
      if include_encoding && (encoding = response_encoding)
        fields << {"grpc-encoding", encoding}
      end
      fields << {"grpc-accept-encoding", Compression::ACCEPT_ENCODING}
      @context.response_metadata.to_fields(fields)
    end

    private def send_headers_locked : Nil
      return if @headers_sent
      @headers_sent = true
      emit(Stats::OutHeader.new(@context.response_metadata, response_encoding))
      @transport.send_headers(response_header_fields(include_encoding: true))
    end

    private def encode_body(data : Bytes) : Bytes
      @protocol.web_text? ? Base64.strict_encode(data).to_slice : data
    end

    # gRPC-Web trailers: a frame with the MSB of the flag byte set, holding
    # the trailers as an HTTP/1 header block.
    private def web_trailer_frame(trailers : Array({String, String})) : Bytes
      block = String.build do |io|
        trailers.each { |(name, value)| io << name << ": " << value << "\r\n" }
      end
      frame = Bytes.new(Framing::HEADER_SIZE + block.bytesize)
      frame[0] = 0x80_u8
      IO::ByteFormat::BigEndian.encode(block.bytesize.to_u32, frame[1, 4])
      block.to_slice.copy_to(frame + Framing::HEADER_SIZE)
      frame
    end

    private def emit_in_payload(message : Protobuf::Message?, length : Int32) : Nil
      emit(Stats::InPayload.new(message, length, length + Framing::HEADER_SIZE, @last_in_compressed))
    end

    private def emit(event : Stats::Event) : Nil
      @stats.emit(@rpc_info, event) unless @stats.empty?
    end
  end

  # Intercepts every call handled by a server, e.g. for logging,
  # authentication or metrics. Call `continuation.call` to run the next
  # interceptor or the handler; raise `GRPC::Error` to reject the call.
  #
  # ```
  # class AuthInterceptor < GRPC::ServerInterceptor
  #   def call(context : GRPC::ServerContext, continuation : -> Nil) : Nil
  #     unless context.metadata["authorization"]? == "Bearer secret"
  #       raise GRPC::Error.new(:unauthenticated, "Invalid token")
  #     end
  #     continuation.call
  #   end
  # end
  # ```
  abstract class ServerInterceptor
    abstract def call(context : ServerContext, continuation : -> Nil) : Nil

    # :nodoc:
    class ProcInterceptor < ServerInterceptor
      def initialize(@proc : Proc(ServerContext, Proc(Nil), Nil))
      end

      def call(context : ServerContext, continuation : -> Nil) : Nil
        @proc.call(context, continuation)
      end
    end
  end

  # A gRPC server.
  #
  # ```
  # class Greeter < Helloworld::Greeter::Service
  #   def say_hello(request, context)
  #     Helloworld::HelloReply.new(message: "Hello #{request.name}")
  #   end
  # end
  #
  # server = GRPC::Server.new
  # server.handle(Greeter.new)
  # server.bind("0.0.0.0:50051")
  # server.listen
  # ```
  class Server
    include HTTP2::Server::Handler

    Log = ::Log.for("grpc.server")

    getter max_receive_message_size : Int32
    getter max_send_message_size : Int32
    # Default compression for responses (per call override:
    # `ServerContext#compression=`).
    getter compression : String?

    # Cross-origin policy for gRPC-Web requests from browsers (`nil`
    # disables CORS handling).
    property cors : CORS?
    # Whether gRPC-Web requests are accepted.
    property? web : Bool

    @methods = {} of String => RpcMethod
    @services = [] of Service
    @interceptors = [] of ServerInterceptor
    @stats : Stats::Dispatcher
    @unknown_handler : Proc(ServerCall, Nil)? = nil
    @http2 : HTTP2::Server? = nil
    @settings : HTTP2::Settings
    @connection_window_size : Int32

    def initialize(*, @max_receive_message_size : Int32 = DEFAULT_MAX_RECEIVE_MESSAGE_SIZE,
                   @max_send_message_size : Int32 = DEFAULT_MAX_SEND_MESSAGE_SIZE,
                   @compression : String? = nil,
                   max_concurrent_streams : UInt32? = 100_u32,
                   initial_window_size : UInt32 = 1_048_576_u32,
                   connection_window_size : Int32 = 16_777_216,
                   max_header_list_size : UInt32 = 16_384_u32 * 1024,
                   stats_handlers : Array(StatsHandler) = [] of StatsHandler,
                   @web : Bool = true, @cors : CORS? = nil,
                   @connection_options : HTTP2::ConnectionOptions = HTTP2::Server.default_options,
                   @http1 : Bool = true)
      @stats = Stats::Dispatcher.new(stats_handlers.dup)
      if (encoding = @compression) && !Compression.supported?(encoding)
        raise ArgumentError.new("Unsupported compression #{encoding}")
      end
      @settings = HTTP2::Settings.new(
        max_concurrent_streams: max_concurrent_streams,
        initial_window_size: initial_window_size,
        max_header_list_size: max_header_list_size,
      )
      @connection_window_size = connection_window_size
      ChannelzRegistry.register(self)
    end

    # Identifier of the server in channelz.
    getter channelz_id : Int64 = ChannelzRegistry.next_id
    # Call counters (channelz).
    getter call_metrics = CallMetrics.new
    # When the server was created.
    getter created_at : Time = Time.utc

    # Transport-level connection options: keepalive and its enforcement,
    # connection age/idle limits and abuse limits (see
    # `HTTP2::ConnectionOptions`; defaults follow gRPC's).
    getter connection_options : HTTP2::ConnectionOptions

    # The underlying HTTP/2 server. When gRPC-Web and HTTP/1.1 are enabled
    # (the default), it also answers HTTP/1.1 gRPC-Web requests on the
    # same port.
    def http2 : HTTP2::Server
      @http2 ||= begin
        server = HTTP2::Server.new(self, @settings, @connection_window_size, @connection_options)
        if @web && @http1
          server.http1_handler = HTTP::Handler::HandlerProc.new { |context| call_http1(context) }
        end
        server
      end
    end

    # Serves an HTTP/1.1 request (gRPC-Web).
    def call_http1(context : HTTP::Server::Context) : Nil
      request = context.request
      fields = [] of {String, String}
      request.headers.each do |name, values|
        lower = name.downcase
        next if lower == "host"
        values.each { |value| fields << {lower, value} }
      end
      transport = HTTP1ServerTransport.new(context)
      serve(transport, request.method, request.resource, fields, request.headers["host"]?)
      transport.abort unless transport.closed?
    end

    # Registers a service implementation.
    def handle(service : Service) : self
      @services << service
      name = service.service_name
      service.rpc_methods.each do |method|
        @methods["/#{name}/#{method.name}"] = method
      end
      self
    end

    # Handles calls to methods that are not registered (e.g. to implement
    # a proxy). The block receives the raw call: use
    # `ServerCall#read_raw_message` / `#send_raw_message`, and raise
    # `GRPC::Error` to fail the call.
    def handle_unknown(&block : ServerCall -> Nil) : self
      @unknown_handler = block
      self
    end

    # Adds a stats handler (see `GRPC::Stats`).
    def add_stats_handler(handler : StatsHandler) : self
      @stats.handlers << handler
      self
    end

    # The registered services.
    def services : Array(Service)
      @services.dup
    end

    # Adds an interceptor. Interceptors run in the order they were added.
    def intercept(interceptor : ServerInterceptor) : self
      @interceptors << interceptor
      self
    end

    # Adds an interceptor given as a block.
    def intercept(&block : ServerContext, Proc(Nil) -> Nil) : self
      intercept(ServerInterceptor::ProcInterceptor.new(block))
    end

    # Binds to an address: `host:port`, `[ipv6]:port` or `unix:/path`.
    # Returns the bound address (useful with port 0).
    def bind(address : String) : Socket::Address
      if address.starts_with?("unix:")
        http2.bind_unix(address.lchop("unix:").lchop("//"))
      else
        host, port = parse_host_port(address)
        http2.bind_tcp(host, port)
      end
    end

    def bind_tcp(host : String, port : Int32, reuse_port : Bool = false) : Socket::IPAddress
      http2.bind_tcp(host, port, reuse_port)
    end

    # Binds a TLS listener; `h2` is negotiated with ALPN.
    def bind_tls(host : String, port : Int32, context : OpenSSL::SSL::Context::Server) : Socket::IPAddress
      http2.bind_tls(host, port, context)
    end

    def bind_unix(path : String) : Socket::UNIXAddress
      http2.bind_unix(path)
    end

    # Accepts connections until the server is closed. Blocks.
    def listen : Nil
      http2.listen
    end

    # Starts listening in a background fiber and returns immediately.
    def start : self
      spawn(name: "grpc-server") { listen }
      Fiber.yield
      self
    end

    # Serves a single connection over *io* (for custom transports and
    # tests).
    def handle_connection(io : IO) : Nil
      http2.handle_connection(io)
    end

    # Stops accepting connections and waits up to *timeout* for in-flight
    # calls to complete.
    def close(timeout : Time::Span = 5.seconds) : Nil
      http2.close(timeout)
    end

    def closed? : Bool
      http2.closed?
    end

    # HTTP/2 request handler.
    def call(context : HTTP2::Server::Context) : Nil
      request = context.request
      serve(HTTP2ServerTransport.new(context.stream), request.method, request.path,
        context.stream.headers, request.authority)
    end

    # Serves one HTTP exchange carrying a gRPC (or gRPC-Web) call.
    # *fields* are the request header fields (lowercase names).
    def serve(transport : ServerTransport, method : String, path : String,
              fields : Array({String, String}), authority : String?) : Nil
      header = ->(name : String) { fields.find { |(key, _)| key == name }.try(&.[1]) }
      origin = header.call("origin")
      cors_headers = cors_response_headers(origin)

      if method == "OPTIONS" && cors_headers && header.call("access-control-request-method")
        respond_preflight(transport, cors_headers, header.call("access-control-request-headers"))
        return
      end
      if method != "POST"
        respond_http(transport, 405)
        return
      end

      content_type = header.call("content-type") || ""
      protocol = protocol_for(content_type)
      unless protocol && (protocol.grpc? || @web)
        respond_http(transport, 415)
        return
      end
      if protocol.grpc? && !transport.supports_trailers?
        respond_http(transport, 505)
        return
      end

      timeout = nil
      if raw_timeout = header.call("grpc-timeout")
        timeout = Timeout.decode(raw_timeout)
      end
      server_context = ServerContext.new(path, Metadata.from_fields(fields), timeout, authority, transport.peer, @compression)
      if cors_headers
        cors_headers.each { |(name, value)| server_context.response_metadata.add(name, value) }
      end

      request_encoding = header.call("grpc-encoding")
      accepted = (header.call("grpc-accept-encoding") || "").split(',').map(&.strip).reject(&.empty?)
      call = ServerCall.new(transport, server_context, request_encoding, accepted, @max_receive_message_size,
        @max_send_message_size, protocol, response_content_type(protocol), @stats)
      @call_metrics.record_start
      metrics = @call_metrics
      call.on_finish = ->(status : Status) { metrics.record_end(status.ok?) }
      call.emit_begin(timeout) unless @stats.empty?

      if raw_timeout && timeout.nil?
        call.finish(Status.new(StatusCode::Internal, "Malformed grpc-timeout header #{raw_timeout.inspect}"))
        return
      end
      if request_encoding && !Compression.supported?(request_encoding)
        call.finish(Status.new(StatusCode::Unimplemented, "Unsupported grpc-encoding #{request_encoding}"))
        return
      end

      if method = @methods[path]?
        run_call(call, method.handler, timeout)
      elsif unknown = @unknown_handler
        call.raw_mode!
        run_call(call, unknown, timeout)
      else
        call.finish(Status.new(StatusCode::Unimplemented, "Method not found: #{path}"))
      end
    end

    private def run_call(call : ServerCall, handler : Proc(ServerCall, Nil), timeout : Time::Span?) : Nil
      context = call.context
      done = ::Channel(Nil).new

      call.transport.on_abort do
        context.cancel(StatusCode::Cancelled) unless call.finished?
      end

      if timeout
        spawn(name: "grpc-deadline") do
          select
          when done.receive?
          when timeout(timeout)
            unless call.finished?
              context.cancel(StatusCode::DeadlineExceeded)
              call.expire
            end
          end
        end
      end

      status = begin
        run_interceptors(context, 0) { handler.call(call) }
        Status.ok
      rescue e : Error
        e.metadata.each { |(key, value)| context.trailers.add(key, value) }
        e.status
      rescue e
        Log.error(exception: e) { "Unhandled exception in #{context.method_path}" }
        Status.new(StatusCode::Unknown, e.message || e.class.name)
      end
      call.finish(status)
    ensure
      done.try &.close
    end

    private def protocol_for(content_type : String) : ServerCall::Protocol?
      base = content_type.split(';', 2)[0].strip.downcase
      case base
      when "application/grpc", .starts_with?("application/grpc+")
        ServerCall::Protocol::GRPC
      when "application/grpc-web-text", .starts_with?("application/grpc-web-text+")
        ServerCall::Protocol::WebText
      when "application/grpc-web", .starts_with?("application/grpc-web+")
        ServerCall::Protocol::Web
      end
    end

    private def response_content_type(protocol : ServerCall::Protocol) : String
      case protocol
      in .grpc?     then "application/grpc"
      in .web?      then "application/grpc-web+proto"
      in .web_text? then "application/grpc-web-text+proto"
      end
    end

    private def cors_response_headers(origin : String?) : Array({String, String})?
      policy = @cors
      return nil unless policy && origin && policy.allows?(origin)
      policy.response_headers(origin)
    end

    private def respond_preflight(transport : ServerTransport, cors_headers : Array({String, String}), requested : String?) : Nil
      policy = @cors.not_nil!
      fields = [{":status", "204"}]
      fields.concat(cors_headers)
      fields << {"access-control-allow-methods", "POST, OPTIONS"}
      fields << {"access-control-allow-headers", policy.allowed_headers(requested)}
      fields << {"access-control-max-age", policy.max_age.total_seconds.to_i.to_s}
      transport.send_headers(fields, end_stream: true)
    rescue TransportError
    end

    private def run_interceptors(context : ServerContext, index : Int32, &block : -> Nil) : Nil
      if interceptor = @interceptors[index]?
        interceptor.call(context, -> { run_interceptors(context, index + 1, &block) })
      else
        block.call
      end
    end

    private def respond_http(transport : ServerTransport, status : Int32) : Nil
      code = StatusCode.from_http_status(status)
      transport.send_headers([
        {":status", status.to_s},
        {"content-type", "application/grpc"},
        {"grpc-status", code.value.to_s},
        {"grpc-message", Status.encode_message("HTTP status #{status}")},
      ], end_stream: true)
    rescue TransportError
    end

    private def parse_host_port(address : String) : {String, Int32}
      if address.starts_with?('[')
        host, _, port = address.lchop('[').partition("]:")
      else
        host, _, port = address.rpartition(':')
      end
      raise ArgumentError.new("Invalid address #{address.inspect}") if port.empty?
      {host.empty? ? "0.0.0.0" : host, port.to_i}
    end
  end
end
